# ---- Core ----
# 'production' on the deployed server; leave blank/anything else for local dev.
NODE_ENV=
PORT=5000

# Frontend URL, used for CORS and links in emails.
# Leave blank locally (defaults to http://localhost:5173); set it on the deployed server.
CLIENT_URL=

# ---- Database ----
# MongoDB connection string (e.g. from MongoDB Atlas).
MONGO_URL=

# ---- Auth ----
# Secret used to sign JWTs — use a long random string.
JWT_KEY=

# ---- Cloudinary (image/avatar uploads) ----
# From your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email (Nodemailer / Gmail) ----
# ADMIN_GMAIL_PASSWORD must be a Gmail "App Password" (requires 2FA), not your normal password.
ADMIN_GMAIL=
ADMIN_GMAIL_PASSWORD=

# ---- AI (Groq) ----
# API key from console.groq.com. AI features are disabled if unset.
GROQ_API_KEY=

# ---- PDF export (optional) ----
# Remote browser WebSocket endpoint (e.g. Browserless). If unset, Puppeteer
# launches a local Chrome instead — fine for local dev.
BROWSER_WS_ENDPOINT=
